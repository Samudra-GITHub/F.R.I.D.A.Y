# W.E.D.N.E.S.D.A.Y. — Environment Configuration Template
# Copy this file to .env and configure local values as needed. The backend loads .env
# from the repository root on startup; variables already set in the environment win.
# IMPORTANT: Never commit .env or real secrets to version control.

# ------------------------------------------------------------------------------
# Location Enrichment Provider (Phase 2D)
# ------------------------------------------------------------------------------
# Choose the active location enrichment provider:
# - osm    : Free OpenStreetMap data via Nominatim (reverse geocoding) and Overpass API (nearby POIs).
#            Requires no API key. Honors public service usage policies (1 req/sec rate limit).
# - google : Google Maps Platform (Geocoding & Places API New). Requires GOOGLE_MAPS_API_KEY.
# - none   : No external location enrichment (device location tracking still operates offline).
LOCATION_PROVIDER=osm

# ------------------------------------------------------------------------------
# OpenStreetMap (OSM) Platform Configuration (Optional Overrides)
# ------------------------------------------------------------------------------
# Nominatim Reverse Geocoding Endpoint:
# OSM_NOMINATIM_URL=https://nominatim.openstreetmap.org/reverse
#
# Overpass API Nearby POI Endpoints (Primary and Fallback):
# OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
# OSM_OVERPASS_FALLBACK_URL=https://overpass.kumi.systems/api/interpreter
#
# User-Agent and Contact for Nominatim Usage Policy compliance:
# OSM_USER_AGENT=FRIDAY-Assistant/0.1.0
# OSM_CONTACT_EMAIL=your_email@example.com

# ------------------------------------------------------------------------------
# Google Maps Platform Configuration (Phase 2C Place Intelligence)
# ------------------------------------------------------------------------------
# 1. Obtain an API key from Google Cloud Console (https://console.cloud.google.com/)
# 2. Recommended API Restrictions:
#    - Geocoding API
#    - Places API (New)
# 3. Recommended Application Restrictions:
#    - IP address restriction (for production server), or leave unrestricted for private localhost development.
#    - DO NOT share or expose this key to client-side bundles (React / Vite).
#
# When GOOGLE_MAPS_API_KEY is unset or empty, W.E.D.N.E.S.D.A.Y. safely runs in offline mode
# with status "provider_not_configured" without failing or fabricating place data.
# GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ------------------------------------------------------------------------------
# Workspace & Location Storage Overrides (Optional)
# ------------------------------------------------------------------------------
# FRIDAY_WORKSPACE=C:\Users\username\FridayWorkspace
# FRIDAY_LOCATION_STATE=C:\Users\username\.friday\location_state.json
# FRIDAY_LOCATION_LOCK=C:\Users\username\.friday\location.lock

# ------------------------------------------------------------------------------
# Earth layers
# ------------------------------------------------------------------------------
# Satellites (CelesTrak), flights (adsb.lol), launches (Launch Library 2) need no key.
# Active fires need a free NASA FIRMS MAP_KEY: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# FIRMS_MAP_KEY=

# ------------------------------------------------------------------------------
# Speech recognition
# ------------------------------------------------------------------------------
# Backend default engine: windows_sapi (default) or faster_whisper.
# Whisper needs `pip install -e .[whisper]` and local weights; see docs/overhaul/handoff.md.
# FRIDAY_STT_PROVIDER=windows_sapi
# FRIDAY_WHISPER_MODEL=C:\Users\username\.friday\models\faster-whisper-base.en
