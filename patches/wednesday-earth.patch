+++ b/src/app/wednesdayEarth.js
@@ -0,0 +1,706 @@
+/**
+ * W.E.D.N.E.S.D.A.Y. Earth: the planet as a living environment.
+ *
+ * - Opens on the whole planet, lit by the real sun, turning slowly while untouched.
+ * - The orbit dial reports the camera's true altitude and moves it between presets.
+ * - The device marker shows only a position the shell reports; Earth never reads
+ *   location itself, and coordinates arrive by message, never in a URL.
+ * - FOCUS ON ME is an orbital approach: swing around the planet, then descend.
+ * - Selecting something quiets everything else; returning restores the clean view.
+ */
+
+import * as Cesium from 'cesium';
+import { announceNavigationAuthority } from '../navigationPolicy.js';
+import { msg, t } from '../i18n/index.js';
+import { EARTHQUAKE_OVERLAY_SOURCE_ID } from '../layers/earthquakes/model.js';
+import { hitTestWorldOverlay } from '../overlays/worldOverlay.js';
+import {
+  holdContinuousRender,
+  releaseContinuousRender,
+} from '../renderGovernor.js';
+
+export const LOCATION_MESSAGE = 'wednesday:location';
+export const FOCUS_MESSAGE = 'wednesday:focus';
+export const LOCATE_REQUEST_MESSAGE = 'wednesday:locate-request';
+export const VISIBILITY_MESSAGE = 'wednesday:visibility';
+export const QUIET_MESSAGE = 'wednesday:quiet';
+
+const EARTH_RADIUS_M = 6371000;
+/** Room for the status bar above and the controls below. */
+const EDGE_MARGIN = 1.4;
+const FLIGHT_SECONDS = 2.2;
+const ORBIT_SECONDS = 1.7;
+const DESCENT_SECONDS = 2.6;
+const FOCUS_RANGE_M = 1200000;
+/** Over the Atlantic, with Africa and Europe in view, when no position is known. */
+const DEFAULT_CENTER = Object.freeze({ latitude: 18, longitude: 12 });
+const LAYERS_KEY = 'wednesday.earth.layers';
+const LAYERS_SAVE_MS = 10000;
+/** A first visit shows real public data that needs no key, rather than an empty planet. */
+const DEFAULT_LAYERS = Object.freeze(['satellites', 'flights', 'earthquakes']);
+/** One turn in six minutes: visibly alive, slow enough to read. */
+const SPIN_RADIANS_PER_SECOND = (2 * Math.PI) / 360;
+const SPIN_MAX_STEP_SECONDS = 0.1;
+const SPIN_AFTER_IDLE_MS = 8000;
+const QUIET_AFTER_IDLE_MS = 6000;
+const HOLD_ID = 'wednesday-earth-spin';
+/** The dial's arc around the planet, in degrees from straight right. */
+const DIAL_START_DEG = -46;
+const DIAL_END_DEG = 46;
+
+export const PRESETS = Object.freeze([
+  Object.freeze({ id: 'global', label: msg('GLOBAL'), pitchDeg: -90 }),
+  Object.freeze({ id: 'continent', label: msg('CONTINENT'), rangeM: 6500000, pitchDeg: -90 }),
+  Object.freeze({ id: 'regional', label: msg('REGIONAL'), rangeM: 1200000, pitchDeg: -90 }),
+  Object.freeze({ id: 'local', label: msg('LOCAL'), rangeM: 30000, pitchDeg: -60, atDevice: true }),
+  Object.freeze({ id: 'street', label: msg('STREET'), rangeM: 900, pitchDeg: -35, atDevice: true }),
+]);
+
+/**
+ * Camera height at which the whole sphere fits in the narrower side of the view.
+ * @param {number} fovyRad Vertical field of view.
+ * @param {number} aspect Width divided by height.
+ */
+export function fullEarthHeightM(fovyRad, aspect) {
+  const fovx = 2 * Math.atan(Math.tan(fovyRad / 2) * aspect);
+  const narrow = Math.min(fovyRad, fovx);
+  return (EARTH_RADIUS_M * EDGE_MARGIN) / Math.sin(narrow / 2) - EARTH_RADIUS_M;
+}
+
+/** Which preset a camera height is closest to, compared on a log scale. */
+export function presetForHeight(heightM, globalHeightM) {
+  let best = PRESETS[0].id;
+  let bestGap = Infinity;
+  for (const preset of PRESETS) {
+    const range = preset.rangeM ?? globalHeightM;
+    const gap = Math.abs(Math.log(Math.max(heightM, 1) / range));
+    if (gap < bestGap) {
+      best = preset.id;
+      bestGap = gap;
+    }
+  }
+  return best;
+}
+
+/**
+ * Where a camera height sits on the dial: 0 at global, 1 at street, log-scaled
+ * because each preset is roughly an order of magnitude from the next.
+ */
+export function dialFraction(heightM, globalHeightM) {
+  const nearest = PRESETS[PRESETS.length - 1].rangeM;
+  const span = Math.log(globalHeightM / nearest);
+  const value = Math.log(globalHeightM / Math.max(heightM, 1)) / span;
+  return Math.min(1, Math.max(0, value));
+}
+
+/** A point on the dial's arc, as screen pixels from the view's centre. */
+export function dialPoint(fraction, radius) {
+  const deg = DIAL_START_DEG + (DIAL_END_DEG - DIAL_START_DEG) * fraction;
+  const rad = (deg * Math.PI) / 180;
+  return { x: Math.cos(rad) * radius, y: Math.sin(rad) * radius };
+}
+
+/**
+ * A position the shell sent, or null when it has none to show. Bad values are
+ * refused, so nothing is ever drawn at a made-up place.
+ */
+export function readDevicePosition(data) {
+  const { latitude, longitude, fresh, approximate, label } = data ?? {};
+  if (
+    !Number.isFinite(latitude) ||
+    !Number.isFinite(longitude) ||
+    Math.abs(latitude) > 90 ||
+    Math.abs(longitude) > 180
+  )
+    return null;
+  return {
+    latitude,
+    longitude,
+    fresh: fresh === true,
+    approximate: approximate === true,
+    label: typeof label === 'string' ? label.slice(0, 120) : '',
+  };
+}
+
+/** The layers to turn on when Earth opens: what was on last time, or the first-visit set. */
+export function layersToRestore(stored, knownIds) {
+  let wanted = DEFAULT_LAYERS;
+  if (stored) {
+    try {
+      const parsed = JSON.parse(stored);
+      if (Array.isArray(parsed)) wanted = parsed;
+    } catch {
+      /* unreadable preference: use the first-visit set */
+    }
+  }
+  return wanted.filter((id) => knownIds.includes(id));
+}
+
+/**
+ * The lens for one earthquake, from its USGS record. A missing value is left
+ * out, never estimated.
+ * @param {{mag?: number, place?: string, depth?: number, time?: number}} quake
+ * @param {number} now Current time in milliseconds.
+ */
+export function earthquakeFacts(quake, now = Date.now()) {
+  const mag = Number(quake?.mag);
+  const title = [
+    Number.isFinite(mag) ? `M${mag.toFixed(1)}` : '',
+    typeof quake?.place === 'string' ? quake.place.trim() : '',
+  ]
+    .filter(Boolean)
+    .join(' · ');
+  const facts = [];
+  const depth = Number(quake?.depth);
+  if (quake?.depth != null && Number.isFinite(depth))
+    facts.push(t('{depth} km deep', { depth: depth.toFixed(0) }));
+  const time = Number(quake?.time);
+  if (quake?.time != null && Number.isFinite(time)) {
+    const hours = Math.max(0, (now - time) / 3600000);
+    facts.push(
+      hours < 1
+        ? t('{minutes} min ago', { minutes: Math.round(hours * 60) })
+        : t('{hours} h ago', { hours: Math.round(hours) }),
+    );
+  }
+  facts.push('USGS');
+  return { title, facts };
+}
+
+/** What a selected thing is called, from whichever of the app's records describes it. */
+export function focusTitle(subject) {
+  for (const value of [subject?.label, subject?.title, subject?.name, subject?.id]) {
+    if (typeof value === 'string' && value.trim()) return value.trim().slice(0, 80);
+  }
+  return '';
+}
+
+const prefersReducedMotion = (windowRef) =>
+  windowRef.matchMedia?.('(prefers-reduced-motion: reduce)')?.matches === true;
+
+/** Add the dial, the device marker, focus mode, and shell messages. Returns a remover. */
+export function installWednesdayEarth({
+  viewer,
+  dataManager,
+  run,
+  ready,
+  signal,
+  windowRef = globalThis.window,
+}) {
+  const doc = windowRef.document;
+  const body = doc.body;
+  const camera = viewer.camera;
+  const scene = viewer.scene;
+  const reducedMotion = prefersReducedMotion(windowRef);
+  const removers = [];
+  const listen = (target, type, handler, options) => {
+    target.addEventListener(type, handler, options);
+    removers.push(() => target.removeEventListener(type, handler, options));
+  };
+  let position = null;
+  let visible = true;
+  let lastInteraction = Date.now();
+  let flying = false;
+  let focused = false;
+  let opened = false;
+
+  // The real sun lights the planet: day and night are where they are right now.
+  scene.globe.enableLighting = true;
+  scene.globe.dynamicAtmosphereLighting = true;
+  scene.globe.dynamicAtmosphereLightingFromSun = true;
+
+  const flightSeconds = () => (reducedMotion ? 0 : FLIGHT_SECONDS);
+
+  const globalHeight = () => {
+    const { fovy, aspectRatio } = camera.frustum;
+    return fullEarthHeightM(fovy ?? 0.6, aspectRatio ?? 16 / 9);
+  };
+
+  /** The spot under the view's centre, so changing zoom keeps the place in view. */
+  const viewCenter = () => {
+    const canvas = scene.canvas;
+    const hit = camera.pickEllipsoid(
+      new Cesium.Cartesian2(canvas.clientWidth / 2, canvas.clientHeight / 2),
+    );
+    const carto = hit
+      ? Cesium.Cartographic.fromCartesian(hit)
+      : camera.positionCartographic;
+    return {
+      latitude: Cesium.Math.toDegrees(carto.latitude),
+      longitude: Cesium.Math.toDegrees(carto.longitude),
+    };
+  };
+
+  const flyOver = (
+    { latitude, longitude },
+    rangeM,
+    pitchDeg,
+    duration,
+    { headingDeg = 0, complete } = {},
+  ) => {
+    announceNavigationAuthority('embed-view');
+    flying = true;
+    const done = () => {
+      flying = false;
+      lastInteraction = Date.now();
+    };
+    camera.flyToBoundingSphere(
+      new Cesium.BoundingSphere(
+        Cesium.Cartesian3.fromDegrees(longitude, latitude),
+        0,
+      ),
+      {
+        duration,
+        easingFunction: Cesium.EasingFunction.CUBIC_IN_OUT,
+        offset: new Cesium.HeadingPitchRange(
+          Cesium.Math.toRadians(headingDeg),
+          Cesium.Math.toRadians(pitchDeg),
+          rangeM,
+        ),
+        complete: () => {
+          done();
+          complete?.();
+        },
+        cancel: done,
+      },
+    );
+  };
+
+  const showGlobal = (center, duration = flightSeconds()) =>
+    flyOver(center, globalHeight(), -90, duration);
+
+  /**
+   * The signature move: swing around the planet at altitude until the target
+   * faces the camera, then descend with a slow turn. A straight flight tunnels
+   * through the view and loses the sense of where you are.
+   */
+  const orbitalApproach = (target, rangeM, pitchDeg, complete) => {
+    if (reducedMotion) {
+      flyOver(target, rangeM, pitchDeg, 0, { complete });
+      return;
+    }
+    const altitude = camera.positionCartographic.height;
+    if (altitude < rangeM * 8) {
+      flyOver(target, rangeM, pitchDeg, FLIGHT_SECONDS, { headingDeg: 20, complete });
+      return;
+    }
+    flyOver(target, Math.max(altitude, globalHeight() * 0.6), -90, ORBIT_SECONDS, {
+      complete: () =>
+        flyOver(target, rangeM, pitchDeg, DESCENT_SECONDS, {
+          headingDeg: 20,
+          complete,
+        }),
+    });
+  };
+
+  const goToPreset = async (preset) => {
+    lastInteraction = Date.now();
+    await run('stop_tracking', {});
+    // Callouts bury the planet from far out; close in, they're the point. Going
+    // down they wait for arrival, so they don't flood the view mid-flight.
+    const close = preset.atDevice === true;
+    if (!close) await run('set_detection', { enabled: false });
+    const arrive = () => {
+      if (close) void run('set_detection', { enabled: true });
+    };
+    const range = preset.rangeM ?? globalHeight();
+    if (preset.atDevice && position) {
+      orbitalApproach(position, range, preset.pitchDeg, arrive);
+      return;
+    }
+    flyOver(viewCenter(), range, preset.pitchDeg, flightSeconds(), {
+      complete: arrive,
+    });
+  };
+
+  // ---- Orbit dial -----------------------------------------------------------
+  const dial = doc.createElement('nav');
