+    }
+    const known = dataManager.getAll().map((layer) => layer.id);
+    for (const layerId of layersToRestore(stored, known)) {
+      if (dataManager.isEnabled(layerId)) continue;
+      await run('set_layer_visibility', { layerId, enabled: true }).catch(
+        (error) => console.warn(`[Earth] could not restore ${layerId}:`, error),
+      );
+    }
+    layersRestored = true;
+  };
+
+  // Every opening starts on the whole planet, whatever a previous visit left.
+  void ready.then(async () => {
+    if (signal?.aborted) return;
+    void restoreLayers();
+    await run('stop_tracking', {});
+    await run('set_detection', { enabled: false });
+    showGlobal(position ?? DEFAULT_CENTER, 0);
+    opened = true;
+    lastInteraction = Date.now();
+    syncYou();
+    syncDial();
+  });
+
+  return () => {
+    for (const remove of removers) remove();
+    windowRef.clearInterval(saveTimer);
+    setSpinning(false);
+    dial.remove();
+    you.remove();
+    lens.remove();
+    body.classList.remove('earth-quiet');
+    delete body.dataset.earthFocus;
+  };
+}
diff --git a/src/app/wednesdayEarth.test.mjs b/src/app/wednesdayEarth.test.mjs
new file mode 100644
index 0000000..90c8dbd
--- /dev/null
+++ b/src/app/wednesdayEarth.test.mjs
@@ -0,0 +1,116 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import {
+  PRESETS,
+  dialFraction,
+  dialPoint,
+  earthquakeFacts,
+  focusTitle,
+  fullEarthHeightM,
+  layersToRestore,
+  presetForHeight,
+  readDevicePosition,
+} from './wednesdayEarth.js';
+
+const RADIUS = 6371000;
+/** Angular radius of the Earth seen from `height`, against half the narrower view. */
+const fits = (height, fovy, aspect) => {
+  const fovx = 2 * Math.atan(Math.tan(fovy / 2) * aspect);
+  return Math.asin(RADIUS / (RADIUS + height)) < Math.min(fovy, fovx) / 2;
+};
+
+test('the whole planet fits at every window shape', () => {
+  for (const aspect of [0.5, 1, 16 / 9, 2.4]) {
+    const height = fullEarthHeightM(0.6, aspect);
+    assert.ok(fits(height, 0.6, aspect), `aspect ${aspect}`);
+    assert.ok(height > 10000000, 'far enough to read as a planet');
+  }
+});
+
+test('a narrow window moves the camera further back', () => {
+  assert.ok(fullEarthHeightM(0.6, 0.5) > fullEarthHeightM(0.6, 16 / 9));
+});
+
+test('camera heights map to the nearest preset', () => {
+  const global = 18000000;
+  assert.equal(presetForHeight(global, global), 'global');
+  assert.equal(presetForHeight(7000000, global), 'continent');
+  assert.equal(presetForHeight(1000000, global), 'regional');
+  assert.equal(presetForHeight(25000, global), 'local');
+  assert.equal(presetForHeight(600, global), 'street');
+});
+
+test('presets run from far to near, starting at global', () => {
+  assert.equal(PRESETS[0].id, 'global');
+  const ranges = PRESETS.slice(1).map(({ rangeM }) => rangeM);
+  assert.deepEqual(ranges, [...ranges].sort((a, b) => b - a));
+});
+
+test('only real coordinates become a position', () => {
+  assert.equal(readDevicePosition({ latitude: 91, longitude: 0 }), null);
+  assert.equal(readDevicePosition({ latitude: 0, longitude: 181 }), null);
+  assert.equal(readDevicePosition({ latitude: '22', longitude: 88 }), null);
+  assert.equal(readDevicePosition({ latitude: null, longitude: null }), null);
+  assert.equal(readDevicePosition(undefined), null);
+  assert.deepEqual(
+    readDevicePosition({ latitude: 0, longitude: 0, fresh: true }),
+    { latitude: 0, longitude: 0, fresh: true, approximate: false, label: '' },
+  );
+});
+
+test('a position is treated as stale unless the shell says it is fresh', () => {
+  assert.equal(readDevicePosition({ latitude: 1, longitude: 2 }).fresh, false);
+  assert.equal(
+    readDevicePosition({ latitude: 1, longitude: 2, fresh: 'yes' }).fresh,
+    false,
+  );
+});
+
+test('a first visit opens with public layers, and later visits with what was on', () => {
+  const known = ['satellites', 'flights', 'earthquakes', 'dams'];
+  assert.deepEqual(layersToRestore(null, known), ['satellites', 'flights', 'earthquakes']);
+  assert.deepEqual(layersToRestore('["dams"]', known), ['dams']);
+  assert.deepEqual(layersToRestore('[]', known), [], 'turning everything off is remembered');
+  assert.deepEqual(layersToRestore('["gone","dams"]', known), ['dams'], 'unknown layers are dropped');
+  assert.deepEqual(layersToRestore('not json', ['flights']), ['flights']);
+});
+
+test('the dial runs from global at the top of its range to street at the bottom', () => {
+  const top = 18000000;
+  assert.equal(dialFraction(top, top), 0);
+  assert.equal(dialFraction(900, top), 1);
+  assert.equal(dialFraction(top * 2, top), 0, 'beyond global stays on the dial');
+  assert.equal(dialFraction(10, top), 1, 'below street stays on the dial');
+  const mid = dialFraction(100000, top);
+  assert.ok(mid > 0.4 && mid < 0.7, `log scale, got ${mid}`);
+});
+
+test('the dial sweeps down the right side of the planet', () => {
+  const start = dialPoint(0, 100);
+  const end = dialPoint(1, 100);
+  assert.ok(start.x > 0 && end.x > 0, 'stays right of centre');
+  assert.ok(start.y < 0 && end.y > 0, 'global above, street below');
+  assert.ok(Math.abs(Math.hypot(end.x, end.y) - 100) < 1e-9, 'stays on the circle');
+});
+
+test('a selection is named from its own record, never invented', () => {
+  assert.equal(focusTitle({ label: 'DHK2506', id: 'abc' }), 'DHK2506');
+  assert.equal(focusTitle({ name: 'M 4.7' }), 'M 4.7');
+  assert.equal(focusTitle({ id: 'abc' }), 'abc');
+  assert.equal(focusTitle({ label: '  ', id: 3 }), '');
+  assert.equal(focusTitle(null), '');
+});
+
+test('an earthquake lens shows what USGS reported and leaves out what it did not', () => {
+  const now = Date.parse('2026-10-31T12:00:00Z');
+  const full = earthquakeFacts(
+    { mag: 4.72, place: '10 km S of Hualien', depth: 12.4, time: now - 2 * 3600000 },
+    now,
+  );
+  assert.equal(full.title, 'M4.7 · 10 km S of Hualien');
+  assert.equal(full.facts.length, 3);
+  assert.equal(full.facts.at(-1), 'USGS');
+  const sparse = earthquakeFacts({ mag: 5, depth: null, time: undefined }, now);
+  assert.equal(sparse.title, 'M5.0');
+  assert.deepEqual(sparse.facts, ['USGS']);
+});
