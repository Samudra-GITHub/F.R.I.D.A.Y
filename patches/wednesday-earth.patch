diff --git a/src/layers/trackedModels.js b/src/layers/trackedModels.js
new file mode 100644
index 0000000..546173f
--- /dev/null
+++ b/src/layers/trackedModels.js
@@ -0,0 +1,93 @@
+/**
+ * 3D models for a single selected satellite or ship. Only the selected object gets
+ * one: thousands of models would swamp the frame budget, and from far away a symbol
+ * reads better anyway. Each is drawn at a real record's position.
+ */
+
+import * as Cesium from 'cesium';
+
+export const SATELLITE_MODEL_URL = '/models/satellite.glb';
+export const SHIP_MODEL_URL = '/models/ship.glb';
+
+/** Big enough to read as an object at the follow camera's distance. */
+const SATELLITE_MIN_PX = 96;
+const SHIP_MIN_PX = 64;
+
+/**
+ * The direction a ship model should face, from what AIS reported. AIS uses 511 for
+ * "heading not available", so fall back to course; with neither, null means unknown.
+ * @param {{heading?: number|null, course?: number|null}} record
+ * @returns {number|null} Degrees clockwise from north.
+ */
+export function vesselHeadingDegrees(record) {
+  for (const value of [record?.heading, record?.course]) {
+    if (Number.isFinite(value) && value >= 0 && value < 360) return value;
+  }
+  return null;
+}
+
+/**
+ * Whether a catalogue name is a working spacecraft. Rocket bodies and debris share
+ * the catalogue, and a model with solar wings would misrepresent them.
+ * @param {string} name Catalogue name, such as "ISS (ZARYA)" or "SL-3 R/B".
+ */
+export function looksLikeSpacecraft(name) {
+  return !/(^|[\s-])(R\/B|DEB|DEBRIS|ROCKET|AKM|PKM)(\s|$)/i.test(String(name ?? ''));
+}
+
+/** Orientation at `position` for a heading, with the model's +X axis as its bow. */
+function orientationAt(position, headingDeg) {
+  // headingPitchRollQuaternion maps the model's +X axis onto the given heading.
+  return Cesium.Transforms.headingPitchRollQuaternion(
+    position,
+    new Cesium.HeadingPitchRoll(
+      Cesium.Math.toRadians(headingDeg),
+      0,
+      0,
+    ),
+  );
+}
+
+/** Model graphics for a tracked satellite; it holds its dish toward the Earth. */
+export function satelliteModelGraphics() {
+  return {
+    uri: SATELLITE_MODEL_URL,
+    minimumPixelSize: SATELLITE_MIN_PX,
+    maximumScale: 200000,
+  };
+}
+
+/**
+ * Show a ship model at a selected vessel. Position and heading are read from the
+ * record each frame, so it follows AIS updates. Returns a remover.
+ * @param {object} viewer Cesium viewer.
+ * @param {() => object|null} getPosition Current Cartesian position of the vessel.
+ * @param {object} record Vessel record, updated in place by the feed.
+ */
+export function addShipModel(viewer, getPosition, record) {
+  const entity = viewer.entities.add({
+    position: new Cesium.CallbackPositionProperty(getPosition, false),
+    orientation: new Cesium.CallbackProperty(() => {
+      const position = getPosition();
+      return position
+        ? orientationAt(position, vesselHeadingDegrees(record) ?? 0)
+        : undefined;
+    }, false),
+    model: {
+      uri: SHIP_MODEL_URL,
+      minimumPixelSize: SHIP_MIN_PX,
+      maximumScale: 2000,
+    },
+  });
+  return () => {
+    if (!viewer.isDestroyed?.()) viewer.entities.remove(entity);
+  };
+}
+
+/** Orientation property for a satellite entity at its live position. */
+export function satelliteOrientation(getPosition) {
+  return new Cesium.CallbackProperty(() => {
+    const position = getPosition();
+    return position ? orientationAt(position, 0) : undefined;
+  }, false);
+}
diff --git a/src/layers/trackedModels.test.mjs b/src/layers/trackedModels.test.mjs
new file mode 100644
index 0000000..e8a8b35
--- /dev/null
+++ b/src/layers/trackedModels.test.mjs
@@ -0,0 +1,80 @@
+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+import test from 'node:test';
+import { MODELS, toGlb } from '../../scripts/generate-models.mjs';
+import { looksLikeSpacecraft, vesselHeadingDegrees } from './trackedModels.js';
+
+/** Read a GLB's JSON chunk, checking the container's own bookkeeping. */
+function parseGlb(glb) {
+  assert.equal(glb.readUInt32LE(0), 0x46546c67, 'magic');
+  assert.equal(glb.readUInt32LE(4), 2, 'version');
+  assert.equal(glb.readUInt32LE(8), glb.length, 'declared length');
+  const jsonLength = glb.readUInt32LE(12);
+  assert.equal(jsonLength % 4, 0, 'JSON chunk is aligned');
+  assert.equal(glb.readUInt32LE(16), 0x4e4f534a, 'JSON chunk type');
+  const json = JSON.parse(glb.subarray(20, 20 + jsonLength).toString('utf8'));
+  const binStart = 20 + jsonLength;
+  assert.equal(glb.readUInt32LE(binStart + 4), 0x004e4942, 'binary chunk type');
+  assert.equal(glb.readUInt32LE(binStart) % 4, 0, 'binary chunk is aligned');
+  assert.ok(glb.readUInt32LE(binStart) >= json.buffers[0].byteLength);
+  return json;
+}
+
+for (const [file, build] of Object.entries(MODELS)) {
+  test(`${file} is a well-formed, light model`, () => {
+    const glb = toGlb(build());
+    const json = parseGlb(glb);
+    const { primitives } = json.meshes[0];
+    assert.equal(primitives.length, json.materials.length);
+    for (const { attributes, material } of primitives) {
+      const position = json.accessors[attributes.POSITION];
+      const normal = json.accessors[attributes.NORMAL];
+      assert.ok(position.count > 0 && position.count % 3 === 0, 'whole triangles');
+      assert.equal(position.count, normal.count);
+      assert.ok(json.materials[material]);
+      assert.equal(position.min.length, 3);
+    }
+    assert.ok(glb.length < 100000, 'cheap to load and draw');
+  });
+
+  test(`public/models/${file} is what the generator writes`, async () => {
+    const onDisk = await readFile(new URL(`../../public/models/${file}`, import.meta.url));
+    assert.ok(onDisk.equals(toGlb(build())), 'run node scripts/generate-models.mjs');
+  });
+}
+
+test('the ship is solid: outer walls face outward, so nothing is culled away', () => {
+  const glb = toGlb(MODELS['ship.glb']());
+  const json = parseGlb(glb);
+  const binStart = 20 + glb.readUInt32LE(12) + 8;
+  const hull = json.meshes[0].primitives[json.materials.findIndex((m) => m.name === 'hull')];
+  const view = json.bufferViews[json.accessors[hull.attributes.POSITION].bufferView];
+  const positions = new Float32Array(
+    glb.buffer.slice(glb.byteOffset + binStart + view.byteOffset, glb.byteOffset + binStart + view.byteOffset + view.byteLength),
+  );
+  // Every triangle's winding on the hull's flat sides must point away from the centreline.
+  let checked = 0;
+  for (let i = 0; i + 8 < positions.length; i += 9) {
+    const [ax, ay, az, bx, by, bz, cx, cy, cz] = positions.slice(i, i + 9);
+    if (Math.abs(Math.abs(az) - 15) > 1e-3 || az !== bz || bz !== cz) continue;
+    const normalZ = (bx - ax) * (cy - ay) - (by - ay) * (cx - ax);
+    assert.ok(Math.sign(normalZ) === Math.sign(az), 'hull side faces outward');
+    checked++;
+  }
+  assert.ok(checked > 0, 'found hull sides to check');
+});
+
+test('a ship faces its reported heading, then course, and unknown stays unknown', () => {
+  assert.equal(vesselHeadingDegrees({ heading: 90, course: 10 }), 90);
+  assert.equal(vesselHeadingDegrees({ heading: 511, course: 10 }), 10, 'AIS 511 means no heading');
+  assert.equal(vesselHeadingDegrees({ heading: null, course: 0 }), 0);
+  assert.equal(vesselHeadingDegrees({ heading: null, course: null }), null);
+  assert.equal(vesselHeadingDegrees(null), null);
+});
+
+test('rocket bodies and debris are not given a spacecraft model', () => {
+  for (const name of ['ISS (ZARYA)', 'STARLINK-1007', 'GPS BIIF-9', 'SPACEMOBILE-002'])
+    assert.equal(looksLikeSpacecraft(name), true, name);
+  for (const name of ['SL-3 R/B', 'CZ-4B R/B', 'FENGYUN 1C DEB', 'ATLAS 5 CENTAUR ROCKET'])
+    assert.equal(looksLikeSpacecraft(name), false, name);
+});
