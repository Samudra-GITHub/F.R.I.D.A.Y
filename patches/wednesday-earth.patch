+  const quakeHandler = new Cesium.ScreenSpaceEventHandler(scene.canvas);
+  removers.push(() => quakeHandler.destroy());
+  const quakeEntityAt = ({ x, y }) => {
+    const picked = scene.pick(new Cesium.Cartesian2(x, y))?.id;
+    if (typeof picked?.id === 'string' && picked.id.startsWith('earthquake:'))
