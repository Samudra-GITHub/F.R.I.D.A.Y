+  const syncYou = () => {
+    if (!position) {
+      placeYou();
+      return;
+    }
+    you.dataset.state = position.approximate
+      ? 'approximate'
+      : position.fresh
+        ? 'fresh'
+        : 'last-known';
+    youLabel.textContent = position.approximate
+      ? t('You (approximate)')
+      : position.fresh
+        ? t('You')
+        : t('You (last known)');
+    placeYou();
+  };
+
+  // ---- Focus mode: what's selected takes over; returning restores the view ---
+  const lens = doc.createElement('section');
+  lens.id = 'earth-lens';
+  lens.hidden = true;
+  lens.setAttribute('role', 'status');
+  const lensKind = doc.createElement('span');
+  lensKind.className = 'earth-lens__kind';
+  const lensTitle = doc.createElement('span');
+  lensTitle.className = 'earth-lens__title';
+  const lensFacts = doc.createElement('span');
+  lensFacts.className = 'earth-lens__facts';
+  const lensBack = doc.createElement('button');
+  lensBack.type = 'button';
+  lensBack.className = 'earth-lens__back';
+  lensBack.textContent = t('Return to global');
+  lens.append(lensKind, lensTitle, lensFacts, lensBack);
+  body.append(lens);
+
+  const layerLabel = (layerId) => {
+    const layer = dataManager.getAll().find(({ id }) => id === layerId);
+    return layer?.label ?? layer?.name ?? layerId ?? '';
+  };
+
+  const enterFocus = (subject) => {
+    focused = true;
+    lastInteraction = Date.now();
