+    const carto = Cesium.Cartographic.fromCartesian(entity.position.getValue(now));
+    orbitalApproach(
+      {
+        latitude: Cesium.Math.toDegrees(carto.latitude),
+        longitude: Cesium.Math.toDegrees(carto.longitude),
+      },
+      FOCUS_RANGE_M,
+      -90,
+    );
+  }, Cesium.ScreenSpaceEventType.LEFT_CLICK);
+
+  listen(windowRef, 'gev:entity-selected', (event) => enterFocus(event.detail));
+  listen(windowRef, 'gev:awareness-subject-selected', (event) =>
+    enterFocus(event.detail),
+  );
+  listen(windowRef, 'gev:entity-selection-cleared', leaveFocus);
+  listen(windowRef, 'gev:awareness-subject-cleared', leaveFocus);
+  removers.push(
+    viewer.selectedEntityChanged.addEventListener((entity) => {
+      if (entity) {
+        enterFocus({
+          name: entity.name,
+          id: entity.id,
+          layerId: entity.entityCollection?.owner?.name,
+        });
+      }
+    }),
+  );
+
+  // ---- A living planet: slow turn and quiet chrome while nothing's happening ---
+  let spinning = false;
+  let quiet = false;
+  let lastTickMs = Date.now();
+  const setQuiet = (next) => {
+    if (next === quiet) return;
+    quiet = next;
+    body.classList.toggle('earth-quiet', quiet);
+    windowRef.parent?.postMessage({ type: QUIET_MESSAGE, quiet }, '*');
+  };
+  const setSpinning = (next) => {
+    if (next === spinning) return;
+    spinning = next;
+    if (spinning) holdContinuousRender(HOLD_ID);
+    else releaseContinuousRender(HOLD_ID);
+  };
+  const atGlobal = () =>
+    camera.positionCartographic.height > globalHeight() * 0.7;
+  removers.push(
+    viewer.clock.onTick.addEventListener(() => {
+      const now = Date.now();
+      const step = Math.min(SPIN_MAX_STEP_SECONDS, (now - lastTickMs) / 1000);
+      lastTickMs = now;
+      const idle = now - lastInteraction;
+      const free = opened && visible && !flying && !focused && atGlobal();
+      setQuiet(free && idle > QUIET_AFTER_IDLE_MS);
+      const spin = free && !reducedMotion && idle > SPIN_AFTER_IDLE_MS;
+      setSpinning(spin);
+      if (spin)
+        camera.rotate(Cesium.Cartesian3.UNIT_Z, -SPIN_RADIANS_PER_SECOND * step);
+    }),
