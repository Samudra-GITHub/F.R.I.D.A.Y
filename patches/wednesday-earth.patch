diff --git a/scripts/generate-models.mjs b/scripts/generate-models.mjs
new file mode 100644
index 0000000..610b3c8
--- /dev/null
+++ b/scripts/generate-models.mjs
@@ -0,0 +1,251 @@
+#!/usr/bin/env node
+// Writes the original low-poly satellite and ship models to `public/models`.
+// Re-run after changing a shape: `node scripts/generate-models.mjs`. The output is
+// committed, and needs no modelling tool or third-party asset.
+//
+// Axes follow the app's other models once Cesium has converted them: glTF Y is up,
+// and the ship's bow points along +X.
+import { writeFile } from 'node:fs/promises';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const OUT_DIR = path.resolve(
+  fileURLToPath(new URL('.', import.meta.url)),
+  '..',
+  'public',
+  'models',
+);
+
+/** Collects flat-shaded triangles, one list per material. */
+function createMesh() {
+  const groups = new Map();
+  // The shapes below list corners clockwise seen from outside; glTF front faces are
+  // counter-clockwise, so swap two corners here.
+  const triangle = (material, a, c, b) => {
+    if (!groups.has(material)) groups.set(material, { positions: [], normals: [] });
+    const group = groups.get(material);
+    const u = [b[0] - a[0], b[1] - a[1], b[2] - a[2]];
+    const v = [c[0] - a[0], c[1] - a[1], c[2] - a[2]];
+    const n = [
+      u[1] * v[2] - u[2] * v[1],
+      u[2] * v[0] - u[0] * v[2],
+      u[0] * v[1] - u[1] * v[0],
+    ];
+    const length = Math.hypot(...n) || 1;
+    for (const point of [a, b, c]) {
+      group.positions.push(...point);
+      group.normals.push(n[0] / length, n[1] / length, n[2] / length);
+    }
+  };
+  const quad = (material, a, b, c, d) => {
+    triangle(material, a, b, c);
+    triangle(material, a, c, d);
+  };
+  /** A box, or a tapered one when `topScale` shrinks its top face. */
+  const box = (material, [cx, cy, cz], [sx, sy, sz], topScale = 1) => {
+    const x = sx / 2;
+    const y = sy / 2;
+    const z = sz / 2;
+    const tx = x * topScale;
+    const tz = z * topScale;
+    const b = [
+      [cx - x, cy - y, cz - z],
+      [cx + x, cy - y, cz - z],
+      [cx + x, cy - y, cz + z],
+      [cx - x, cy - y, cz + z],
+    ];
+    const t = [
+      [cx - tx, cy + y, cz - tz],
+      [cx + tx, cy + y, cz - tz],
+      [cx + tx, cy + y, cz + tz],
+      [cx - tx, cy + y, cz + tz],
+    ];
+    quad(material, b[3], b[2], b[1], b[0]);
+    quad(material, t[0], t[1], t[2], t[3]);
+    quad(material, b[0], b[1], t[1], t[0]);
+    quad(material, b[1], b[2], t[2], t[1]);
+    quad(material, b[2], b[3], t[3], t[2]);
+    quad(material, b[3], b[0], t[0], t[3]);
+  };
+  return { groups, triangle, quad, box };
+}
+
+const MATERIALS = {
+  foil: { color: [0.78, 0.6, 0.27], metallic: 0.85, roughness: 0.35 },
+  panel: { color: [0.05, 0.1, 0.28], metallic: 0.5, roughness: 0.25 },
+  metal: { color: [0.68, 0.7, 0.73], metallic: 0.8, roughness: 0.4 },
+  white: { color: [0.86, 0.87, 0.88], metallic: 0, roughness: 0.6 },
+  hull: { color: [0.13, 0.17, 0.24], metallic: 0.2, roughness: 0.7 },
+  boot: { color: [0.42, 0.11, 0.1], metallic: 0, roughness: 0.8 },
+  deck: { color: [0.32, 0.34, 0.36], metallic: 0, roughness: 0.9 },
+  boxA: { color: [0.55, 0.2, 0.14], metallic: 0, roughness: 0.8 },
+  boxB: { color: [0.16, 0.33, 0.45], metallic: 0, roughness: 0.8 },
+  boxC: { color: [0.62, 0.55, 0.32], metallic: 0, roughness: 0.8 },
+};
+
+/** A bus with two solar wings on a boom, and a dish facing the Earth. Size in metres. */
+function satellite() {
+  const mesh = createMesh();
+  mesh.box('foil', [0, 0, 0], [2.4, 2.4, 2.4]);
+  mesh.box('metal', [0, 0, 0], [0.16, 0.16, 11]);
+  for (const side of [-1, 1]) {
+    for (let i = 0; i < 2; i++) {
+      mesh.box('panel', [0, 0, side * (3.1 + i * 2.1)], [2.1, 0.07, 1.95]);
+    }
+  }
+  // Dish: a shallow cone below the bus, because -Y faces the Earth once oriented.
+  const rim = 1.05;
+  const apex = [0, -1.3, 0];
+  const lip = -2.1;
+  const SEGMENTS = 14;
+  for (let i = 0; i < SEGMENTS; i++) {
+    const a0 = (i / SEGMENTS) * 2 * Math.PI;
+    const a1 = ((i + 1) / SEGMENTS) * 2 * Math.PI;
+    const p0 = [Math.cos(a0) * rim, lip, Math.sin(a0) * rim];
+    const p1 = [Math.cos(a1) * rim, lip, Math.sin(a1) * rim];
+    mesh.triangle('white', apex, p0, p1);
+    mesh.triangle('white', apex, p1, p0);
+  }
+  mesh.box('metal', [0, 1.5, 0], [0.5, 0.6, 0.5], 0.4);
+  return mesh;
+}
+
+/** A container ship, bow toward +X. A generic hull, not any real vessel's. */
+function ship() {
+  const mesh = createMesh();
+  const LENGTH = 200;
+  const BEAM = 30;
+  const stern = -LENGTH / 2;
+  const shoulder = LENGTH / 2 - 42;
+  const bow = LENGTH / 2;
+  const half = BEAM / 2;
+  const outline = (y, width) => [
+    [stern, y, -width],
+    [shoulder, y, -width],
+    [bow, y, 0],
+    [shoulder, y, width],
+    [stern, y, width],
+  ];
+  const WATER = 0;
+  const BOOT = 5;
+  const DECK = 18;
+  const low = outline(WATER, half * 0.92);
+  const mid = outline(BOOT, half);
+  const top = outline(DECK, half);
+  const wall = (material, a, b) => {
+    for (let i = 0; i < a.length; i++) {
+      const j = (i + 1) % a.length;
+      mesh.quad(material, a[i], a[j], b[j], b[i]);
+    }
+  };
+  wall('boot', low, mid);
+  wall('hull', mid, top);
+  mesh.triangle('deck', top[0], top[1], top[3]);
+  mesh.triangle('deck', top[0], top[3], top[4]);
+  mesh.triangle('deck', top[1], top[2], top[3]);
+  // Container rows, staggered so the deck reads at a distance.
+  const colors = ['boxA', 'boxB', 'boxC', 'boxB', 'boxA', 'boxC'];
+  for (let row = 0; row < 6; row++) {
+    const x = -32 + row * 26;
+    const height = row % 2 ? 11 : 14;
+    mesh.box(colors[row], [x, DECK + height / 2, 0], [22, height, BEAM - 5]);
+  }
+  // Bridge, set well aft as on most container ships.
+  mesh.box('white', [-74, DECK + 11, 0], [18, 22, BEAM - 6]);
+  mesh.box('white', [-74, DECK + 24, 0], [11, 4, BEAM + 3]);
+  mesh.box('hull', [-88, DECK + 7, 0], [6, 14, 7], 0.8);
+  return mesh;
+}
+
+/** Pack a mesh as a binary glTF 2.0 file. Exported for the test. */
+export function toGlb(mesh) {
+  const names = [...mesh.groups.keys()];
+  const arrays = [];
+  const accessors = [];
+  const bufferViews = [];
+  const primitives = [];
+  const materials = [];
+  let offset = 0;
+  const addView = (values, target) => {
+    const data = new Float32Array(values);
+    bufferViews.push({
+      buffer: 0,
+      byteOffset: offset,
+      byteLength: data.byteLength,
+      target,
+    });
+    arrays.push(data);
+    offset += data.byteLength;
+    return bufferViews.length - 1;
+  };
+  names.forEach((name, index) => {
+    const { positions, normals } = mesh.groups.get(name);
+    const min = [Infinity, Infinity, Infinity];
+    const max = [-Infinity, -Infinity, -Infinity];
+    for (let i = 0; i < positions.length; i++) {
+      min[i % 3] = Math.min(min[i % 3], positions[i]);
+      max[i % 3] = Math.max(max[i % 3], positions[i]);
+    }
+    const count = positions.length / 3;
+    accessors.push(
+      { bufferView: addView(positions, 34962), componentType: 5126, count, type: 'VEC3', min, max },
+      { bufferView: addView(normals, 34962), componentType: 5126, count, type: 'VEC3' },
+    );
+    const { color, metallic, roughness } = MATERIALS[name];
+    materials.push({
+      name,
+      pbrMetallicRoughness: {
+        baseColorFactor: [...color, 1],
+        metallicFactor: metallic,
+        roughnessFactor: roughness,
+      },
+    });
+    primitives.push({
+      attributes: { POSITION: index * 2, NORMAL: index * 2 + 1 },
+      material: index,
+    });
+  });
+  const json = {
+    asset: { version: '2.0', generator: 'W.E.D.N.E.S.D.A.Y. generate-models' },
+    scene: 0,
+    scenes: [{ nodes: [0] }],
+    nodes: [{ mesh: 0 }],
+    meshes: [{ primitives }],
+    materials,
+    accessors,
+    bufferViews,
+    buffers: [{ byteLength: offset }],
+  };
+  const pad = (length) => (4 - (length % 4)) % 4;
+  const jsonBytes = Buffer.from(JSON.stringify(json), 'utf8');
+  const jsonPad = pad(jsonBytes.length);
+  const binPad = pad(offset);
+  const total = 12 + 8 + jsonBytes.length + jsonPad + 8 + offset + binPad;
+  const out = Buffer.alloc(total);
+  out.writeUInt32LE(0x46546c67, 0);
+  out.writeUInt32LE(2, 4);
+  out.writeUInt32LE(total, 8);
+  out.writeUInt32LE(jsonBytes.length + jsonPad, 12);
+  out.writeUInt32LE(0x4e4f534a, 16);
+  jsonBytes.copy(out, 20);
+  out.fill(0x20, 20 + jsonBytes.length, 20 + jsonBytes.length + jsonPad);
+  let cursor = 20 + jsonBytes.length + jsonPad;
+  out.writeUInt32LE(offset + binPad, cursor);
+  out.writeUInt32LE(0x004e4942, cursor + 4);
+  cursor += 8;
+  for (const data of arrays) {
+    Buffer.from(data.buffer).copy(out, cursor);
+    cursor += data.byteLength;
+  }
+  return out;
+}
+
+export const MODELS = { 'satellite.glb': satellite, 'ship.glb': ship };
+
+if (process.argv[1] === fileURLToPath(import.meta.url)) {
+  for (const [file, build] of Object.entries(MODELS)) {
+    const glb = toGlb(build());
+    await writeFile(path.join(OUT_DIR, file), glb);
+    console.log(`models: wrote ${file} (${glb.length} bytes)`);
+  }
+}
