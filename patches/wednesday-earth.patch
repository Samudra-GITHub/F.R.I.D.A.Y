+  const arc = doc.createElementNS(svgNs, 'svg');
+  arc.classList.add('earth-dial__arc');
+  arc.setAttribute('aria-hidden', 'true');
+  const arcPath = doc.createElementNS(svgNs, 'path');
+  arc.append(arcPath);
+  const needle = doc.createElement('span');
+  needle.className = 'earth-dial__needle';
+  needle.setAttribute('aria-hidden', 'true');
+  const buttons = new Map();
+  const stops = doc.createElement('div');
+  stops.className = 'earth-dial__stops';
+  stops.setAttribute('role', 'group');
+  for (const preset of PRESETS) {
+    const button = doc.createElement('button');
+    button.type = 'button';
+    button.className = 'earth-dial__stop';
+    button.textContent = t(preset.label);
+    button.addEventListener('click', () => void goToPreset(preset));
+    stops.append(button);
+    buttons.set(preset.id, button);
+  }
+  const focus = doc.createElement('button');
+  focus.type = 'button';
+  focus.className = 'earth-dial__action';
+  focus.textContent = t('FOCUS ON ME');
+  focus.addEventListener('click', () => {
+    if (position) void goToPreset(PRESETS.find(({ id }) => id === 'local'));
+    // Ask for a new reading if there's none, or the one we have is old.
+    if (!position?.fresh)
+      windowRef.parent?.postMessage({ type: LOCATE_REQUEST_MESSAGE }, '*');
+  });
+  const reset = doc.createElement('button');
+  reset.type = 'button';
+  reset.className = 'earth-dial__action';
+  reset.textContent = t('RESET CAMERA');
+  const resetCamera = async () => {
+    lastInteraction = Date.now();
+    await run('stop_tracking', {});
+    await run('set_detection', { enabled: false });
+    showGlobal(position ?? DEFAULT_CENTER);
+  };
+  reset.addEventListener('click', () => void resetCamera());
+  const actions = doc.createElement('div');
+  actions.className = 'earth-dial__actions';
+  actions.append(focus, reset);
+  dial.append(arc, needle, stops, actions);
+  body.append(dial);
+
+  const dialRadius = () => {
+    const { clientWidth: w, clientHeight: h } = scene.canvas;
+    return Math.min(h * 0.46, w * 0.33);
+  };
+
+  /** Lay the stops along the arc, hugging the planet. CSS uses these only on wide screens. */
+  const layoutDial = () => {
+    const radius = dialRadius();
+    const { clientWidth: w, clientHeight: h } = scene.canvas;
+    const cx = w / 2;
+    const cy = h / 2;
+    const from = dialPoint(0, radius);
+    const to = dialPoint(1, radius);
+    arc.setAttribute('width', String(w));
+    arc.setAttribute('height', String(h));
+    arcPath.setAttribute(
+      'd',
+      `M${cx + from.x} ${cy + from.y}A${radius} ${radius} 0 0 1 ${cx + to.x} ${cy + to.y}`,
+    );
+    PRESETS.forEach((preset, index) => {
+      const point = dialPoint(index / (PRESETS.length - 1), radius);
+      const button = buttons.get(preset.id);
+      button.style.setProperty('--x', `${cx + point.x}px`);
+      button.style.setProperty('--y', `${cy + point.y}px`);
+    });
+  };
+
+  const syncDial = () => {
+    const height = camera.positionCartographic.height;
