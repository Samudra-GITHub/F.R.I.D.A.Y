+    if (!entity) return;
+    const now = viewer.clock.currentTime;
+    const read = (key) => entity.properties?.[key]?.getValue(now);
+    const { title, facts } = earthquakeFacts({
+      mag: read('mag'),
+      place: read('place'),
+      depth: read('depth'),
+      time: read('time'),
+    });
