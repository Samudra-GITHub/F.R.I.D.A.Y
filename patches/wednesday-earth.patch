+    syncDial();
+  });
+  removers.push(camera.changed.addEventListener(syncDial));
+  removers.push(camera.moveEnd.addEventListener(syncDial));
+
+  // ---- Device marker --------------------------------------------------------
+  // A page element, not scene geometry, so its pulse is CSS and costs no renders.
+  const you = doc.createElement('div');
+  you.id = 'earth-you';
+  you.hidden = true;
+  const youHalo = doc.createElement('span');
+  youHalo.className = 'earth-you__halo';
+  const youDot = doc.createElement('span');
+  youDot.className = 'earth-you__dot';
+  const youLabel = doc.createElement('span');
+  youLabel.className = 'earth-you__label';
