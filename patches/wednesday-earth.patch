diff --git a/src/ui/styles/wednesday.css b/src/ui/styles/wednesday.css
new file mode 100644
index 0000000..be7e13a
--- /dev/null
+++ b/src/ui/styles/wednesday.css
@@ -0,0 +1,407 @@
+/*
+ * W.E.D.N.E.S.D.A.Y. Earth: the planet is the interface. The desktop shell supplies
+ * the brand and status bar over the top 56px, so nothing here repeats them.
+ * The Cyber layout stays an explicit choice with its own look, so nothing here
+ * applies once [data-ui-theme='cyber'] is set. Cockpit and phone layouts position
+ * these elements themselves, so layout rules skip them.
+ */
+:root:not([data-ui-theme='cyber']) {
+  --bg-dark: #090b10;
+  --glass-bg: rgba(15, 18, 24, 0.86);
+  --glass-border: rgba(255, 255, 255, 0.07);
+  --glass-border-hover: rgba(255, 255, 255, 0.14);
+  --accent: #e9b872;
+  --accent-dim: rgba(233, 184, 114, 0.14);
+  --accent-glow: rgba(233, 184, 114, 0.16);
+  --text-primary: #eef0f4;
+  --text-secondary: #aab1bf;
+  --text-dim: #7b8394;
+  --menu-bg: #151922;
+  --font-sans: 'Segoe UI Variable Text', 'Segoe UI', -apple-system, BlinkMacSystemFont, sans-serif;
+  --font-data: 'Cascadia Mono', 'Cascadia Code', Consolas, 'SF Mono', monospace;
+  --font-mono: var(--font-sans);
+  --panel-radius: 14px;
+  --btn-radius: 9px;
+  --dock-label-color: #aab1bf;
+  --dock-label-font-size: 0.69rem;
+  --dock-label-font-weight: 600;
+  --dock-label-letter-spacing: 0.05em;
+  --left-stack-x: 84px;
+  --right-rail-x: 16px;
+  --left-stack-top: 72px;
+}
+
+/* Light marks information here, not decoration. */
+:root:not([data-ui-theme='cyber']) :is(#intel-hud, #left-panel-stack, #right-context-rail, #command-dock, #corner-actions, #first-run-launcher, #loading-screen) :is(*, *::before, *::after) {
+  text-shadow: none;
+}
+
+/* ── The shell shows the brand; the Display panel shows the active style ── */
+:root:not([data-ui-theme='cyber']) body:not(.cockpit-mode) :is(#title-bar, #style-indicator, #reset-globe-view) {
+  display: none;
+}
+
+/* ── Globe actions sit just below the shell's status bar ── */
+:root:not([data-ui-theme='cyber']) body:not(.cockpit-mode, .mobile-shell) #top-center-actions {
+  top: 64px;
+}
+
+/* ── Bottom corners: coordinates sit under the attribution ── */
+:root:not([data-ui-theme='cyber']) body:not(.cockpit-mode, .mobile-shell) #intel-hud .hud-bottom-left {
+  left: 84px;
+  bottom: 52px;
+}
+:root:not([data-ui-theme='cyber']) body:not(.cockpit-mode, .mobile-shell) #intel-hud .hud-bottom-right {
+  right: 16px;
+  bottom: 60px;
+}
+
+/* ── View readouts ── */
+:root:not([data-ui-theme='cyber']) #intel-hud {
+  font-family: var(--font-data);
+  font-variant-numeric: tabular-nums;
+  letter-spacing: 0;
+  color: var(--text-secondary);
+}
+:root:not([data-ui-theme='cyber']) #intel-hud :is(.hud-bracket, .hud-bottom-bar, .hud-top-left, .hud-top-right, #hud-mgrs, #hud-gsd, #hud-ais-vessel) {
+  display: none;
+}
+:root:not([data-ui-theme='cyber']) #intel-hud :is(.hud-readout, .hud-readout *) {
+  font-family: var(--font-data);
+  font-size: 0.69rem;
+  letter-spacing: 0;
+  color: var(--text-secondary);
+}
+
+/* ── Panels ── */
+:root:not([data-ui-theme='cyber']) :is(.panel-collapsible, #first-run-launcher) {
+  border-radius: var(--panel-radius);
+  box-shadow: 0 10px 28px rgba(0, 0, 0, 0.34);
+}
+:root:not([data-ui-theme='cyber']) :is(.panel-glow, .first-run-scanline) {
+  display: none;
+}
+
+/* ── Loading ── */
+:root:not([data-ui-theme='cyber']) #loading-screen {
+  background: var(--bg-dark);
+}
+:root:not([data-ui-theme='cyber']) #loading-screen h2 {
+  font: 600 0.95rem/1.2 var(--font-sans);
+  letter-spacing: 0.14em;
+  color: var(--text-primary);
+}
+:root:not([data-ui-theme='cyber']) #loading-screen .title-accent {
+  color: var(--accent);
+}
+
+/* ── Layer filter ── */
+.data-layer-tools {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  margin-bottom: 8px;
+}
+.data-layer-tools .gev-field {
+  flex: 1;
+  min-width: 0;
+}
+.data-layer-on {
+  flex: none;
+  font-size: 0.69rem;
+  color: var(--text-secondary);
+  font-variant-numeric: tabular-nums;
+}
+#data-panel.collapsed .data-layer-tools,
+.data-toggle-row[hidden],
+.data-layer-group-heading[hidden] {
+  display: none;
+}
+
+/* ── Orbit dial: altitude, drawn as an arc that hugs the planet ── */
+#earth-dial {
+  position: fixed;
+  inset: 0;
+  z-index: 40;
+  pointer-events: none;
+  font-family: 'Segoe UI Variable Text', 'Segoe UI', sans-serif;
+  transition: opacity 400ms ease;
+}
+#earth-dial button {
+  pointer-events: auto;
+  border: 0;
+  background: transparent;
+  cursor: pointer;
+  font-family: inherit;
+  white-space: nowrap;
+  transition: color 160ms ease, background 160ms ease;
+}
+.earth-dial__arc {
+  position: absolute;
+  inset: 0;
+}
+.earth-dial__arc path {
+  fill: none;
+  stroke: rgba(233, 184, 114, 0.28);
+  stroke-width: 1;
+}
+.earth-dial__needle {
+  position: absolute;
+  top: -5px;
+  left: -5px;
+  width: 10px;
+  height: 10px;
+  border-radius: 50%;
+  background: #e9b872;
+  box-shadow: 0 0 0 3px rgba(9, 11, 16, 0.9);
+}
+.earth-dial__stop {
+  position: absolute;
+  left: var(--x);
+  top: var(--y);
+  transform: translate(14px, -50%);
+  padding: 4px 8px;
+  border-radius: 6px;
+  color: #7b8394;
+  font-size: 0.69rem;
+  font-weight: 600;
+  letter-spacing: 0.08em;
+}
+.earth-dial__stop:hover {
+  color: #eef0f4;
+  background: rgba(255, 255, 255, 0.06);
+}
+.earth-dial__stop[aria-current='true'] {
+  color: #e9b872;
+}
+.earth-dial__actions {
+  position: absolute;
+  left: 50%;
+  bottom: 112px;
+  transform: translateX(-50%);
+  display: flex;
+  gap: 6px;
+}
+.earth-dial__action {
+  height: 30px;
+  padding: 0 12px;
+  border-radius: 8px;
+  background: rgba(15, 18, 24, 0.82) !important;
+  color: #aab1bf;
+  font-size: 0.69rem;
+  font-weight: 600;
+  letter-spacing: 0.06em;
+}
+.earth-dial__action:hover {
+  color: #eef0f4;
+}
+.earth-dial__action[aria-disabled='true'] {
+  color: #7b8394;
+}
+/* Open trays and the cockpit need this space. */
+body:has(#control-panel:not(.collapsed), #location-bar:not(.collapsed)) .earth-dial__actions,
+body.cockpit-mode #earth-dial {
+  opacity: 0;
+}
+body.cockpit-mode #earth-dial button {
+  pointer-events: none;
+}
+/* Too narrow for an arc beside the planet: the stops become a row. */
+@media (max-width: 899px), (max-height: 559px) {
+  .earth-dial__arc,
+  .earth-dial__needle {
+    display: none;
+  }
+  .earth-dial__stops {
+    position: absolute;
+    left: 50%;
+    bottom: 190px;
+    transform: translateX(-50%);
+    display: flex;
+    max-width: calc(100vw - 24px);
+    overflow-x: auto;
+    scrollbar-width: none;
+    border-radius: 10px;
+    background: rgba(15, 18, 24, 0.82);
+  }
+  .earth-dial__stop {
+    position: static;
+    transform: none;
+  }
+  /* Above the stops, and clear of the voice card that sits over the phone's tab bar. */
+  .earth-dial__actions {
+    bottom: 226px;
+  }
+}
+
+/* ── You are here: the only thing on the planet that breathes ── */
+#earth-you {
+  position: fixed;
+  top: 0;
+  left: 0;
+  z-index: 30;
+  pointer-events: none;
+}
+#earth-you[hidden] {
+  display: none;
+}
+.earth-you__dot {
+  position: absolute;
+  top: -5px;
+  left: -5px;
+  width: 10px;
+  height: 10px;
+  border-radius: 50%;
+  background: #e9b872;
+  box-shadow: 0 0 0 2px #090b10;
+}
+.earth-you__halo {
+  position: absolute;
+  top: -20px;
+  left: -20px;
+  width: 40px;
+  height: 40px;
+  border: 1px solid #e9b872;
+  border-radius: 50%;
+  animation: earth-you-pulse 3.2s cubic-bezier(0.2, 0, 0.2, 1) infinite;
+}
+.earth-you__label {
+  position: absolute;
+  bottom: 14px;
+  left: 0;
+  transform: translateX(-50%);
+  padding: 2px 8px;
+  border-radius: 6px;
+  background: rgba(15, 18, 24, 0.86);
+  color: #eef0f4;
+  font: 600 0.72rem/1.4 'Segoe UI Variable Text', 'Segoe UI', sans-serif;
+  white-space: nowrap;
+}
+/* No pulse for a position that isn't current: nothing is being measured right now. */
+#earth-you[data-state='last-known'] .earth-you__dot {
+  background: #aab1bf;
+}
+#earth-you[data-state='last-known'] .earth-you__halo {
+  animation: none;
+  opacity: 0.35;
+  border-color: #aab1bf;
+  transform: scale(0.6);
+}
+#earth-you[data-state='approximate'] .earth-you__halo {
+  animation: none;
+  opacity: 0.5;
+  border-style: dashed;
+}
+@keyframes earth-you-pulse {
+  0% {
+    transform: scale(0.28);
+    opacity: 0.9;
+  }
+  70%,
+  100% {
+    transform: scale(1);
+    opacity: 0;
+  }
+}
+
+/* ── Focus: what's selected takes over, and the rest steps back ── */
+#earth-lens {
+  position: fixed;
+  top: 68px;
+  left: 50%;
+  z-index: 45;
+  transform: translateX(-50%);
+  display: flex;
+  align-items: baseline;
+  gap: 12px;
+  width: max-content;
+  max-width: calc(100vw - 32px);
+  padding: 8px 8px 8px 16px;
+  border-radius: 12px;
+  background: rgba(15, 18, 24, 0.9);
+  font-family: 'Segoe UI Variable Text', 'Segoe UI', sans-serif;
+  animation: earth-lens-unfold 320ms cubic-bezier(0.16, 1, 0.3, 1);
+}
+#earth-lens[hidden] {
+  display: none;
+}
+.earth-lens__kind {
+  color: #e9b872;
+  font-size: 0.69rem;
+  font-weight: 600;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+  white-space: nowrap;
+}
+.earth-lens__title {
+  overflow: hidden;
+  color: #eef0f4;
+  font-size: 0.95rem;
+  font-weight: 600;
+  white-space: nowrap;
+  text-overflow: ellipsis;
+}
+.earth-lens__facts {
+  color: #aab1bf;
+  font-size: 0.75rem;
+  white-space: nowrap;
+}
+.earth-lens__facts:empty {
+  display: none;
+}
+.earth-lens__back {
+  flex: none;
+  height: 28px;
+  padding: 0 10px;
+  border: 0;
+  border-radius: 7px;
+  background: rgba(255, 255, 255, 0.07);
+  color: #eef0f4;
+  font: 600 0.72rem/1 inherit;
+  font-family: inherit;
+  cursor: pointer;
+}
+.earth-lens__back:hover {
+  background: rgba(255, 255, 255, 0.13);
+}
+@keyframes earth-lens-unfold {
+  from {
+    opacity: 0;
+    clip-path: inset(0 40% 0 40% round 12px);
+  }
+  to {
+    opacity: 1;
+    clip-path: inset(0 0 0 0 round 12px);
+  }
+}
+body[data-earth-focus] :is(#left-panel-stack, #command-dock, #top-center-actions, #earth-dial .earth-dial__stops, .earth-dial__arc, .earth-dial__needle, #corner-actions, #key-setup-chip) {
+  opacity: 0.18;
+  transition: opacity 320ms ease;
+}
+body[data-earth-focus] :is(#left-panel-stack, #command-dock, #top-center-actions, #earth-dial .earth-dial__stops, #corner-actions, #key-setup-chip):is(:hover, :focus-within) {
+  opacity: 1;
+}
+
+/* ── Quiet: left alone, the planet gets the whole stage. Any movement brings it back. ── */
+body.earth-quiet:not(:has(.panel-collapsible:not(.collapsed), #control-panel:not(.collapsed), #location-bar:not(.collapsed))) :is(#left-panel-stack, #right-context-rail, #command-dock, #top-center-actions, #earth-dial, #corner-actions, #key-setup-chip, #intel-hud) {
+  opacity: 0.12;
+  transition: opacity 1200ms ease;
+}
+:is(#left-panel-stack, #right-context-rail, #command-dock, #top-center-actions, #corner-actions, #key-setup-chip, #intel-hud) {
+  transition: opacity 240ms ease;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .earth-you__halo {
+    animation: none;
+    opacity: 0.5;
+    transform: scale(0.7);
+  }
+  #earth-lens {
+    animation: none;
+  }
+  #earth-dial,
+  #earth-dial button {
+    transition: none;
+  }
+}
