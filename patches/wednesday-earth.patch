+      return;
+    }
+    const point = Cesium.Cartesian3.fromDegrees(
+      position.longitude,
+      position.latitude,
+    );
+    const facing = new Cesium.EllipsoidalOccluder(
+      Cesium.Ellipsoid.WGS84,
+      camera.positionWC,
