diff --git a/src/ui/layerFilter.js b/src/ui/layerFilter.js
new file mode 100644
index 0000000..72dccec
--- /dev/null
+++ b/src/ui/layerFilter.js
@@ -0,0 +1,63 @@
+/**
+ * Narrow the data layer list by name and show how many layers are on. Rows and
+ * headings are hidden, never removed, so layer state and voice tools still see
+ * every row.
+ */
+
+/** @param {string} query @param {string[]} names */
+export function layerMatchesFilter(query, names) {
+  const needle = String(query ?? '').trim().toLowerCase();
+  if (!needle) return true;
+  return names.some((name) => String(name ?? '').toLowerCase().includes(needle));
+}
+
+/** @param {HTMLElement} list @param {string} query */
+export function applyLayerFilter(list, query) {
+  let heading = null;
+  let headingHasMatch = false;
+  const closeGroup = () => {
+    if (heading) heading.hidden = !headingHasMatch;
+  };
+  for (const child of list.children) {
+    if (child.classList.contains('data-layer-group-heading')) {
+      closeGroup();
+      heading = child;
+      headingHasMatch = false;
+    } else if (child.classList.contains('data-toggle-row')) {
+      const matches = layerMatchesFilter(query, [
+        child.dataset.layerName,
+        child.querySelector('.data-name')?.textContent,
+        heading?.textContent,
+      ]);
+      child.hidden = !matches;
+      if (matches) headingHasMatch = true;
+    }
+  }
+  closeGroup();
+}
+
+/**
+ * Connect the filter field beside `list`. Safe to call after every re-render.
+ * @param {HTMLElement} list
+ */
+export function syncLayerFilter(list) {
+  const panel = list?.closest?.('#data-panel');
+  const input = panel?.querySelector('#data-layer-filter');
+  if (!input) return;
+  const count = panel.querySelector('#data-layer-on-count');
+  const syncCount = () => {
+    if (count) count.textContent = String(list.querySelectorAll('.data-toggle-btn.active').length);
+  };
+  if (!input.dataset.bound) {
+    input.dataset.bound = 'true';
+    input.addEventListener('input', () => applyLayerFilter(list, input.value));
+    new MutationObserver(syncCount).observe(list, {
+      subtree: true,
+      childList: true,
+      attributes: true,
+      attributeFilter: ['class'],
+    });
+  }
+  applyLayerFilter(list, input.value);
+  syncCount();
+}
diff --git a/src/ui/layerFilter.test.mjs b/src/ui/layerFilter.test.mjs
new file mode 100644
index 0000000..7d76349
--- /dev/null
+++ b/src/ui/layerFilter.test.mjs
@@ -0,0 +1,47 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+
+import { applyLayerFilter, layerMatchesFilter } from './layerFilter.js';
+
+const row = (layerName) => ({
+  hidden: false,
+  dataset: { layerName },
+  classList: { contains: (c) => c === 'data-toggle-row' },
+  querySelector: () => null,
+});
+const heading = (textContent) => ({
+  hidden: false,
+  textContent,
+  classList: { contains: (c) => c === 'data-layer-group-heading' },
+});
+
+test('an empty filter matches everything and matching ignores case', () => {
+  assert.equal(layerMatchesFilter('  ', ['Satellites']), true);
+  assert.equal(layerMatchesFilter('SAT', ['Satellites']), true);
+  assert.equal(layerMatchesFilter('dams', ['Satellites', undefined]), false);
+});
+
+test('filtering hides rows and any heading left with no rows, without removing them', () => {
+  const movement = heading('Movement');
+  const satellites = row('Satellites');
+  const flights = row('Live Flights');
+  const world = heading('World');
+  const dams = row('Dams');
+  const list = { children: [movement, satellites, flights, world, dams] };
+
+  applyLayerFilter(list, 'flight');
+  assert.deepEqual(
+    list.children.map((c) => c.hidden),
+    [false, true, false, true, true],
+  );
+
+  applyLayerFilter(list, 'world');
+  assert.deepEqual(
+    list.children.map((c) => c.hidden),
+    [true, true, true, false, false],
+    'a group name shows the whole group',
+  );
+
+  applyLayerFilter(list, '');
+  assert.ok(list.children.every((c) => !c.hidden));
+});
