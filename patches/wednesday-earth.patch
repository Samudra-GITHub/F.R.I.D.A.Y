+    lastInteraction = Date.now();
+    setSpinning(false);
+    setQuiet(false);
+  };
+  for (const type of ['pointerdown', 'pointermove', 'wheel', 'keydown']) {
+    listen(windowRef, type, noteInteraction, { passive: true });
+  }
